        "assignments": {
          "assignments": [
            {
              "id": "d1a0b100-0001-4000-8000-000000000001",
              "name": "project_dir",
              "value": "c:\\Users\\jonid\\Documents\\GitHub\\customer-churn-predictor",
              "type": "string"
            },
            {
              "id": "d1a0b100-0001-4000-8000-000000000002",
              "name": "python_bin",
              "value": "python",
              "type": "string"
            },
            {
              "id": "d1a0b100-0001-4000-8000-000000000003",
              "name": "shell",
              "value": "windows",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
