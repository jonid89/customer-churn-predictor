            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "e2b1c300-1111-4a11-8111-000000000001",
              "leftValue": "={{ $json.churn_probability }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "e2b1c300-1111-4a11-8111-000000000002",
              "leftValue": "={{ $json.already_churned }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
