      "name": "Runtime Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        540,
        540
      ],
      "notes": "shell is windows or linux. python_bin can be venv\\Scripts\\python.exe."
    },
    {
      "parameters": {
        "command": ["={{ $json.shell === 'windows' ? 'cd /d \"' + $json.project_dir + '\" ",
          "&& \"' + $json.python_bin + '\" src/batch_score.py' : 'cd \"' + ",
          "$json.project_dir + '\" && \"' + $json.python_bin + '\" src/batch_score.py' }}"]
      },
      "id": "c4a1e8b0-7d32-4f61-9a10-0b6e1c2d3004",
      "name": "Score with XGBoost",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        820,
        540
      ],
      "executeOnce": true,
      "notes": "Loads models/model.joblib and models/preprocessor.joblib, same as streamlit/app.py."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": ["const stdout = $input.first().json.stdout || '';\nconst start = stdout.indexOf('[');\nconst end = stdout.lastIndexOf(']');\nif (start === -1 || end < start) {\n",
          "  const stderr = $input.first().json.stderr || stdout.slice(0, 500);\n  throw new Error('XGBoost scoring script did not return a JSON array. ' + stderr);\n}\nconst customers = JSON.parse(stdout.slice(start, end + 1));\n",
          "if (!Array.isArray(customers)) {\n  throw new Error('Expected a JSON array of scored customers.');\n}\nreturn customers.map((customer) => ({ json: customer }));\n"]
      },
      "id": "c4a1e8b0-7d32-4f61-9a10-0b6e1c2d3005",
      "name": "Parse Scored Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        540
      ]
    },
    {
      "parameters": {
