      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Header Auth credential: Name x-api-key, Value = ANTHROPIC_API_KEY. Sends one Messages API call per high-risk customer.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "anthropicHeaderAuth",
          "name": "Anthropic API Key"
        }
      }
    },
