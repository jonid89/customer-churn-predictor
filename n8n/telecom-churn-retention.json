          "combinator": "and"
        },
        "options": {}
      },
      "id": "c4a1e8b0-7d32-4f61-9a10-0b6e1c2d3007",
      "name": "High Churn Risk?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1600,
        540
      ],
      "notes": "True branch matches tab_action.py: probability > 70. Already-churned rows stay on the false branch."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": ["const customer = $input.item.json;\nconst monthlyNumber = Number(customer.monthly_charges);\nconst monthly = Number.isFinite(monthlyNumber) ? monthlyNumber.toFixed(2) : String(customer.monthly_charges);\nconst prompt = [\n  'You are an expert customer retention specialist for a telecommunications company.',\n",
          "  'Write a highly personalized retention email to a customer who is at high risk of churning.',\n  '',\n  'Customer Profile:',\n  `- Tenure: ${customer.tenure} months`,\n  `- Contract Type: ${customer.contract}`,\n  `- Monthly Charges: $${monthly}`,\n  `- Main reasons for churn risk: ${customer.top_reasons_str}`,\n  '',\n  'Instructions:',\n  '1. Write an engaging subject line.',\n  '2. Be warm and empathetic.',\n",
          "  '3. Address their specific profile subtly (e.g., if they are month-to-month, offer an incentive to switch to a 1-year plan).',\n  '4. Offer a compelling retention incentive (discount, free upgrade, etc.).',\n  '5. Keep the email concise and professional. Sign off as \"The Retention Team\".',\n].join('\\n');\n\nreturn { json: { ...customer, prompt } };\n"]
      },
      "id": "c4a1e8b0-7d32-4f61-9a10-0b6e1c2d3008",
      "name": "Build Retention Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1880,
        380
      ],
      "notes": "Same profile fields and instructions as the Claude prompt in streamlit/tab_action.py."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": ["={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 400,\n  \"temperature\": 0.7,\n",
          "  \"system\": \"You are a world-class telecom retention expert.\",\n  \"messages\": [\n    {\n",
          "      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($json.prompt) }}\n    }\n  ]\n}"],
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          },
          "timeout": 120000
        }
      },
      "id": "c4a1e8b0-7d32-4f61-9a10-0b6e1c2d3009",
      "name": "Draft Retention Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
